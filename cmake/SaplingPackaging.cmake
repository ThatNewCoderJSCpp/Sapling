if(APPLE)
    set(SAPLING_PACKAGE_GENERATORS "TGZ;TXZ;ZIP" CACHE STRING "Package formats cpack produces")
else()
    set(SAPLING_PACKAGE_GENERATORS "TGZ;TXZ;ZIP;DEB;RPM" CACHE STRING "Package formats cpack produces")
endif()
set(CPACK_GENERATOR ${SAPLING_PACKAGE_GENERATORS})
set(CPACK_PACKAGE_CONTACT "ThatNewCoderJSCpp <https://github.com/ThatNewCoderJSCpp/Sapling>")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/ThatNewCoderJSCpp/Sapling")
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}")
set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/SaplingCPackOptions.cmake")

if(NOT APPLE)
    set(_sapling_pkg "${CMAKE_CURRENT_SOURCE_DIR}/Packaging")
    install(FILES "${_sapling_pkg}/linux/sapling.desktop" DESTINATION share/applications COMPONENT sapling)
    install(FILES "${_sapling_pkg}/icons/sapling.svg" DESTINATION share/icons/hicolor/scalable/apps COMPONENT sapling)
    install(FILES "${_sapling_pkg}/icons/sapling-512.png" DESTINATION share/icons/hicolor/512x512/apps RENAME sapling.png COMPONENT sapling)

    set(_sapling_scripts "${CMAKE_BINARY_DIR}/package-scripts")
    file(MAKE_DIRECTORY "${_sapling_scripts}")
    file(COPY "${_sapling_pkg}/linux/postinst" "${_sapling_pkg}/linux/prerm" DESTINATION "${_sapling_scripts}"
        FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)

    set(CPACK_DEBIAN_PACKAGE_NAME sapling)
    set(CPACK_DEBIAN_FILE_NAME ${CPACK_PACKAGE_FILE_NAME}.deb)
    set(CPACK_DEBIAN_PACKAGE_SECTION science)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA "${_sapling_scripts}/postinst;${_sapling_scripts}/prerm")

    set(CPACK_RPM_PACKAGE_NAME sapling)
    set(CPACK_RPM_FILE_NAME ${CPACK_PACKAGE_FILE_NAME}.rpm)
    set(CPACK_RPM_PACKAGE_GROUP "Applications/Engineering")
    set(CPACK_RPM_PACKAGE_LICENSE "See https://github.com/ThatNewCoderJSCpp/Sapling")
    set(CPACK_RPM_PACKAGE_URL "https://github.com/ThatNewCoderJSCpp/Sapling")
    set(CPACK_RPM_PACKAGE_AUTOREQ ON)
    set(CPACK_RPM_PACKAGE_AUTOPROV OFF)
    set(CPACK_RPM_SPEC_MORE_DEFINE "%define _build_id_links none\n%define debug_package %{nil}\n%define __os_install_post %{nil}")
    set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION /opt)
    set(CPACK_RPM_POST_INSTALL_SCRIPT_FILE "${_sapling_scripts}/postinst")
    set(CPACK_RPM_PRE_UNINSTALL_SCRIPT_FILE "${_sapling_scripts}/prerm")

    if(_sapling_arch STREQUAL "arm64")
        set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE arm64)
        set(CPACK_RPM_PACKAGE_ARCHITECTURE aarch64)
    elseif(_sapling_arch STREQUAL "i686")
        set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE i386)
        set(CPACK_RPM_PACKAGE_ARCHITECTURE i686)
    elseif(_sapling_arch STREQUAL "x86_64")
        set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE amd64)
        set(CPACK_RPM_PACKAGE_ARCHITECTURE x86_64)
    endif()
endif()
