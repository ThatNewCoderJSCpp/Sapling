on_change("spe-end", []() -> void { spe_set_mode(spe_mode); });
on_change("spe-fwhm", []() -> void { spe_set_mode(spe_mode); });
on_click("spe-range-visible", []() -> void {
    by("spe-start").set_value_float(static_cast<short float>(380.0));
