function ccall(const string&: name, const string&: argument) -> string {
    return grove::call("sapling." + name, argument);
} end function ccall

function cmd(const string&: view, const string&: args) -> string {
    return ccall("chem.cmd", view + "\t" + args);
} end function cmd

function tool(const string&: args) -> string {
    return ccall("chem.tool", args);
} end function tool

function panel(const string&: view, const string&: args) -> string {
    return ccall("chem.panel", view + "\t" + args);
} end function panel

function toolpanel(const string&: args) -> string {
    return ccall("chem.toolpanel", args);
} end function toolpanel

function by(const string&: id) -> grove::Element {
    return grove::get_by_id(id);
} end function by

function cel(const string&: tag, const string&: cls, const string&: label) -> grove::Element {
    grove::Element: e = grove::create_element(tag);
    if (!cls.empty()) then {
        e.set_attribute("class", cls);
    }
    if (!label.empty()) then {
        e.set_inner_text(label);
    }
    return e;
} end function cel

function cclear(grove::Element&: e) -> void {
    while (e.child_count() > 0l) {
        e.child(0l).remove();
    }
} end function cclear

function b01(bool: v) -> string {
    if (v) then {
        return "1";
    }
    return "0";
} end function b01

function field(const string&: body, long int: index) -> string {
    auto: f = body.split("\t");
    if (index < f.size()) then {
        return f[index];
    }
    return "";
} end function field

function state_value(const string&: key) -> string {
    auto: rows = cmd("bond", "state").split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() >= 2l && f[0] == key) then {
            return f[1];
        }
    }
    return "";
} end function state_value

function fill_panel(const string&: id, const string&: body) -> void {
    grove::Element: box = by(id);
    cclear(box);
    auto: rows = body.split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 2l) then {
            continue;
        }
        if (f[0] == "h") then {
            grove::Element: line = cel("row", "panel-line", "");
            line.append_child(cel("text", "panel-head", f[1]));
            box.append_child(line);
        } else if (f[0] == "w") then {
            grove::Element: line = cel("row", "panel-line", "");
            line.append_child(cel("text", "panel-warn", f[1]));
            box.append_child(line);
        } else if (f[0] == "n") then {
            grove::Element: line = cel("row", "panel-line", "");
            line.append_child(cel("text", "panel-note", f[1]));
            box.append_child(line);
        } else if (f[0] == "a") then {
            grove::Element: line = cel("row", "panel-line", "");
            line.append_child(cel("text", "panel-assume", f[1]));
            box.append_child(line);
        } else if (f[0] == "x") then {
            grove::Element: line = cel("row", "panel-line", "");
            line.append_child(cel("text", "panel-fail", f[1]));
            box.append_child(line);
        } else if (f.size() >= 3l) then {
            grove::Element: row = cel("row", "panel-row", "");
            row.append_child(cel("text", "panel-label", f[1]));
            row.append_child(cel("text", "panel-value", f[2]));
            box.append_child(row);
        }
    }
} end function fill_panel

function add_option(grove::Element&: select, const string&: value, const string&: label) -> void {
    grove::Element: o = grove::create_element("option");
    o.set_attribute("value", value);
    if (label.empty()) then {
        o.set_inner_text(value);
    } else then {
        o.set_inner_text(label);
    }
    select.append_child(o);
} end function add_option

function fill_select(const string&: id, const string&: body, const string&: keep) -> void {
    grove::Element: s = by(id);
    cclear(s);
    auto: rows = body.split("\n");
    bool: found = false;
    string: first = "";
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        if (rows[i].empty()) then {
            continue;
        }
        auto: f = rows[i].split("\t");
        string: label = "";
        if (f.size() > 1l) then {
            label = f[1];
        }
        add_option(s, f[0], label);
        if (first.empty()) then {
            first = f[0];
        }
        if (f[0] == keep) then {
            found = true;
        }
    }
    if (found) then {
        s.set_value_string(keep);
    } else if (!first.empty() && !s.has_attribute("placeholder")) then {
        s.set_value_string(first);
    }
} end function fill_select

function fill_units() -> void {
    grove::ElementList: list = grove::query_all(".unit-select");
    for (long int: i = 0l; i < list.size(); i += 1l) {
        grove::Element: s = list.at(i);
        string: dim = s.get_attribute("dimension");
        string: keep = s.get_attribute("value");
        string: units = tool("unit_list\t" + dim);
        cclear(s);
        auto: rows = units.split("\n");
        for (long int: k = 0l; k < rows.size(); k += 1l) {
            if (!rows[k].empty()) then {
                add_option(s, rows[k], "");
            }
        }
        if (!keep.empty()) then {
            s.set_value_string(keep);
        }
    }
} end function fill_units

function seg_on(const string&: ids, const string&: on) -> void {
    auto: list = ids.split(",");
    for (long int: i = 0l; i < list.size(); i += 1l) {
        grove::Element: b = by(list[i]);
        if (list[i] == on) then {
            b.add_class("on");
        } else then {
            b.remove_class("on");
        }
    }
} end function seg_on

function show_if(const string&: id, bool: visible) -> void {
    grove::Element: e = by(id);
    if (visible) then {
        e.remove_class("hidden");
    } else then {
        e.add_class("hidden");
    }
} end function show_if

function on_click(const string&: id, function() -> void: fn) -> void {
    by(id).on("click", [fn](grove::Event&: e) -> void {
        fn();
    });
} end function on_click

function on_change(const string&: id, function() -> void: fn) -> void {
    by(id).on("change", [fn](grove::Event&: e) -> void {
        fn();
    });
} end function on_change

function status(const string&: id, const string&: reply, const string&: good) -> void {
    if (field(reply, 0l) == "error") then {
        by(id).set_inner_text(field(reply, 1l));
    } else then {
        by(id).set_inner_text(good);
    }
} end function status

function bond_refresh() -> void {
    if (bond_mode == "network") then {
        fill_panel("bond-readouts", panel("network", "readouts"));
        fill_panel("bond-selection", panel("network", "selection"));
        return;
    }
    fill_panel("bond-readouts", panel("bond", "readouts"));
    fill_panel("bond-selection", panel("bond", "selection"));
    if (bond_mode == "covalent") then {
        fill_select("cov-resonance", cmd("bond", "resonance_list"), by("cov-resonance").value_string());
        bond_sync_neutrons();
    }
} end function bond_refresh

function bond_sync_neutrons() -> void {
    string: n = cmd("bond", "selected_neutrons");
    if (n.empty()) then {
        by("cov-neutrons-note").set_inner_text("Select an atom first");
        return;
    }
    by("cov-neutrons").set_value_integer(std::io::parse_int<long int>(n));
    by("cov-neutrons-note").set_inner_text("0 is the most common isotope");
} end function bond_sync_neutrons

function bond_set_mode(const string&: mode) -> void {
    bond_mode = mode;
    if (mode != "network") then {
        cmd("bond", "mode\t" + mode);
    }
    seg_on("bond-mode-covalent,bond-mode-ionic,bond-mode-metallic,bond-mode-network", "bond-mode-" + mode);
    show_if("cov-controls", mode == "covalent");
    show_if("ion-controls", mode == "ionic");
    show_if("metal-controls", mode == "metallic");
    show_if("net-controls", mode == "network");
    show_if("lattice-controls", mode == "ionic" || mode == "metallic");
    show_if("bond-view-row", mode != "network");
    show_if("chem-bond-view", mode != "network");
    show_if("chem-network-view", mode == "network");
    show_if("bond-tp-group", mode != "network");
    show_if("bond-save-group", mode != "network");
    by("opt-neighbors").set_value_bool(mode == "ionic");
    bond_saved_refresh();
    bond_refresh();
} end function bond_set_mode

function bond_tp_args() -> string {
    return "tp\t" + by("bond-t").value_float().to_string() + "\tK\t" + by("bond-p").value_float().to_string() + "\tPa";
} end function bond_tp_args

function bond_send_tp() -> void {
    string: reply = cmd("bond", bond_tp_args());
    status("bond-save-status", reply, "");
    bond_refresh();
} end function bond_send_tp

function bond_saved_refresh() -> void {
    fill_select("bond-saved", cmd("bond", "saved\t" + bond_mode), by("bond-saved").value_string());
} end function bond_saved_refresh

function metal_build_sliders() -> void {
    grove::Element: box = by("metal-fractions");
    cclear(box);
    auto: syms = by("metal-elements").value_string().split(" ");
    long int: n = 0l;
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        if (!syms[i].empty()) then {
            n += 1l;
        }
    }
    if (n == 0l) then {
        return;
    }
    short float: share = static_cast<short float>(100.0 / n);
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        string: sym = syms[i];
        if (sym.empty()) then {
            continue;
        }
        grove::Element: row = cel("row", "line", "");
        row.append_child(cel("text", "label-w", sym));
        grove::Element: s = grove::create_element("input_slider");
        s.set_attribute("id", "mf-" + sym);
        s.set_attribute("class", "grow");
        s.set_attribute("min", "0");
        s.set_attribute("max", "100");
        s.set_attribute("step", "0.5");
        s.set_value_float(share);
        s.on("input", [sym](grove::Event&: e) -> void {
            metal_normalize(sym);
        });
        s.on("change", [sym](grove::Event&: e) -> void {
            metal_normalize(sym);
            metal_send();
        });
        row.append_child(s);
        box.append_child(row);
    }
} end function metal_build_sliders

function round1(short float: v) -> short float {
    long int: tenths = static_cast<long int>(v * static_cast<short float>(10.0) + static_cast<short float>(0.5));
    return static_cast<short float>(tenths) / static_cast<short float>(10.0);
} end function round1

function metal_normalize(const string&: changed) -> void {
    auto: syms = by("metal-elements").value_string().split(" ");
    short float: hundred = static_cast<short float>(100.0);
    short float: zero = static_cast<short float>(0.0);
    short float: fixed_value = by("mf-" + changed).value_float();
    if (fixed_value > hundred) then {
        fixed_value = hundred;
    }
    short float: others = zero;
    long int: count = 0l;
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        if (syms[i].empty() || syms[i] == changed || !by("mf-" + syms[i]).exists()) then {
            continue;
        }
        others = others + by("mf-" + syms[i]).value_float();
        count += 1l;
    }
    if (count == 0l) then {
        fixed_value = hundred;
    }
    short float: left = hundred - fixed_value;
    short float: used = zero;
    long int: seen = 0l;
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        if (syms[i].empty() || syms[i] == changed || !by("mf-" + syms[i]).exists()) then {
            continue;
        }
        seen += 1l;
        short float: v = zero;
        if (seen == count) then {
            v = left - used;
        } else if (others > zero) then {
            v = round1(by("mf-" + syms[i]).value_float() * left / others);
        } else then {
            v = round1(left / static_cast<short float>(count));
        }
        if (v < zero) then {
            v = zero;
        }
        used = used + v;
        by("mf-" + syms[i]).set_value_float(v);
    }
    by("mf-" + changed).set_value_float(fixed_value);
} end function metal_normalize

function metal_send() -> void {
    auto: syms = by("metal-elements").value_string().split(" ");
    string: spec = "";
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        if (syms[i].empty()) then {
            continue;
        }
        grove::Element: s = by("mf-" + syms[i]);
        if (!s.exists()) then {
            continue;
        }
        spec = spec + syms[i] + "=" + s.value_float().to_string() + ";";
    }
    string: reply = cmd("bond", "metal\t" + spec);
    status("bond-save-status", reply, "");
    bond_refresh();
} end function metal_send

function metal_preset(const string&: symbols, const string&: percents) -> void {
    by("metal-elements").set_value_string(symbols);
    metal_build_sliders();
    auto: syms = symbols.split(" ");
    auto: pct = percents.split(" ");
    for (long int: i = 0l; i < syms.size() && i < pct.size(); i += 1l) {
        by("mf-" + syms[i]).set_value_float(std::io::parse_float<short float>(pct[i]));
    }
    metal_send();
} end function metal_preset

function ions_fill_list() -> void {
    grove::Element: box = by("ions-list");
    cclear(box);
    auto: rows = tool("ions\t" + by("ions-category").value_string() + "\t" + by("ions-search").value_string()).split("\n");
    long int: shown = 0l;
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 4l) then {
            continue;
        }
        string: name = f[0];
        grove::Element: row = cel("row", "ion-row", "");
        row.append_child(cel("text", "ion-formula", f[1]));
        row.append_child(cel("text", "ion-name", f[0]));
        row.on("click", [name](grove::Event&: e) -> void {
            ions_show(name);
        });
        box.append_child(row);
        shown += 1l;
    }
    by("ions-count").set_inner_text(shown.to_string() + " ions");
} end function ions_fill_list

function ions_show(const string&: name) -> void {
    string: reply = cmd("structure", "show\t" + name);
    if (field(reply, 0l) == "ok") then {
        by("ions-title").set_inner_text(field(reply, 1l));
    } else then {
        by("ions-title").set_inner_text(name + " (no structure)");
    }
    fill_panel("ions-info", toolpanel("ion_info\t" + name));
    fill_panel("ions-structure", panel("structure", "readouts"));
} end function ions_show

function st_units(const string&: idx) -> void {
    string: state = by("st-state-" + idx).value_string();
    grove::Element: unit = by("st-unit-" + idx);
    string: previous = unit.value_string();
    cclear(unit);
    string: first = "g";
    if (state == "aq") then {
        add_option(unit, "mL", "mL of solution");
        add_option(unit, "L", "L of solution");
        first = "mL";
    } else if (state == "g") then {
        add_option(unit, "L of gas", "L of gas");
        add_option(unit, "mL of gas", "mL of gas");
        add_option(unit, "L over water", "L collected over water");
        add_option(unit, "mL over water", "mL collected over water");
        add_option(unit, "atm", "atm (partial pressure)");
        add_option(unit, "kPa", "kPa (partial pressure)");
        add_option(unit, "torr", "torr (partial pressure)");
        add_option(unit, "mmHg", "mmHg (partial pressure)");
        add_option(unit, "bar", "bar (partial pressure)");
        first = "L of gas";
    } else if (state == "l") then {
        add_option(unit, "mL of liquid", "mL of liquid");
        add_option(unit, "L of liquid", "L of liquid");
        first = "mL of liquid";
    }
    add_option(unit, "g", "");
    add_option(unit, "kg", "");
    add_option(unit, "mg", "");
    if (state == "s" || state.empty()) then {
        add_option(unit, "lb", "");
    }
    add_option(unit, "mol", "");
    add_option(unit, "mmol", "");
    add_option(unit, "particles", "");
    if (previous == "g" || previous == "kg" || previous == "mg" || previous == "mol" || previous == "mmol" || previous == "particles") then {
        unit.set_value_string(previous);
    } else then {
        unit.set_value_string(first);
    }
    show_if("st-mol-" + idx, state == "aq");
    show_if("st-cond-" + idx, state == "g");
} end function st_units

function st_load(const string&: equation) -> void {
    by("st-equation").set_value_string(equation);
    grove::Element: box = by("st-species");
    cclear(box);
    string: rows_text = tool("stoich_species\t" + equation);
    st_count = 0l;
    if (field(rows_text, 0l) == "error") then {
        box.append_child(cel("text", "panel-warn", field(rows_text, 1l)));
        return;
    }
    auto: rows = rows_text.split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 5l) then {
            continue;
        }
        string: idx = f[0];
        string: likely = "";
        if (f.size() > 5l) then {
            likely = f[5];
        }
        grove::Element: head = cel("row", "species-row", "");
        head.append_child(cel("text", "species-name grow", f[3] + " " + f[1]));
        grove::Element: state = grove::create_element("input_select");
        state.set_attribute("id", "st-state-" + idx);
        state.set_attribute("class", "state-select");
        add_option(state, "s", "(s) solid");
        add_option(state, "l", "(l) liquid");
        add_option(state, "g", "(g) gas");
        add_option(state, "aq", "(aq) dissolved");
        if (likely.empty()) then {
            state.set_value_string("s");
        } else then {
            state.set_value_string(likely);
        }
        state.on("change", [idx](grove::Event&: e) -> void {
            st_units(idx);
        });
        head.append_child(state);
        grove::Element: role = grove::create_element("input_select");
        role.set_attribute("id", "st-role-" + idx);
        role.set_attribute("class", "role-select");
        if (f[2] == "reactant") then {
            add_option(role, "start", "at the start");
            add_option(role, "used", "used up");
            add_option(role, "left", "left over");
            role.set_value_string("start");
        } else then {
            add_option(role, "made", "made");
            add_option(role, "end", "there at the end");
            add_option(role, "start", "there at the start");
            role.set_value_string("made");
        }
        head.append_child(role);
        box.append_child(head);
        grove::Element: row = cel("row", "species-row", "");
        grove::Element: amount = grove::create_element("input_string");
        amount.set_attribute("id", "st-amt-" + idx);
        amount.set_attribute("class", "grow");
        amount.set_attribute("placeholder", "blank: worked out (" + f[4] + " g/mol)");
        row.append_child(amount);
        grove::Element: unit = grove::create_element("input_select");
        unit.set_attribute("id", "st-unit-" + idx);
        row.append_child(unit);
        grove::Element: molar = grove::create_element("input_string");
        molar.set_attribute("id", "st-mol-" + idx);
        molar.set_attribute("class", "small");
        molar.set_attribute("placeholder", "M");
        row.append_child(molar);
        box.append_child(row);
        grove::Element: cond = cel("row", "species-row", "");
        cond.set_attribute("id", "st-cond-" + idx);
        cond.append_child(cel("text", "muted", "measured at"));
        grove::Element: tc = grove::create_element("input_string");
        tc.set_attribute("id", "st-tc-" + idx);
        tc.set_attribute("class", "grow");
        tc.set_attribute("placeholder", "T, e.g. 27 C");
        cond.append_child(tc);
        grove::Element: pc = grove::create_element("input_string");
        pc.set_attribute("id", "st-pc-" + idx);
        pc.set_attribute("class", "grow");
        pc.set_attribute("placeholder", "P, e.g. 750 torr");
        cond.append_child(pc);
        grove::Element: vc = grove::create_element("input_string");
        vc.set_attribute("id", "st-vc-" + idx);
        vc.set_attribute("class", "grow");
        vc.set_attribute("placeholder", "in V, e.g. 5 L");
        cond.append_child(vc);
        box.append_child(cond);
        st_units(idx);
        st_count += 1l;
    }
} end function st_load

function st_solve() -> void {
    string: spec = "";
    for (long int: i = 0l; i < st_count; i += 1l) {
        string: idx = i.to_string();
        string: v = by("st-amt-" + idx).value_string();
        spec = spec + idx + "|" + v + "|" + by("st-unit-" + idx).value_string() + "|" + by("st-mol-" + idx).value_string() + "|M|" + by("st-tc-" + idx).value_string() + "|" + by("st-pc-" + idx).value_string() + "|" + by("st-vc-" + idx).value_string() + "|" + by("st-role-" + idx).value_string() + "|" + by("st-state-" + idx).value_string() + ";";
    }
    string: args = "stoich\t" + by("st-equation").value_string() + "\t" + spec;
    args = args + "\t" + by("st-t").value_float().to_string() + "\t" + by("st-t-unit").value_string();
    args = args + "\t" + by("st-p").value_float().to_string() + "\t" + by("st-p-unit").value_string();
    args = args + "\t" + by("st-out-unit").value_string();
    string: vol = "";
    if (by("st-vol").value_float() > static_cast<short float>(0.0)) then {
        vol = by("st-vol").value_float().to_string();
    }
    args = args + "\t" + by("st-mode").value_string() + "\t" + vol + "\t" + by("st-vol-unit").value_string();
    args = args + "\t" + b01(by("st-water").value_bool()) + "\t" + b01(by("st-real").value_bool());
    args = args + "\t" + by("st-inert").value_float().to_string() + "\t" + by("st-inert-name").value_string();
    fill_panel("st-out", toolpanel(args));
} end function st_solve

function sv_fill_equations() -> void {
    fill_select("sv-equation", tool("equations\t" + by("sv-category").value_string()), by("sv-equation").value_string());
    sv_load_equation();
} end function sv_fill_equations

function sv_load_equation() -> void {
    string: id = by("sv-equation").value_string();
    grove::Element: box = by("sv-vars");
    cclear(box);
    grove::Element: unknown = by("sv-unknown");
    cclear(unknown);
    add_option(unknown, "", "the blank one");
    sv_vars = "";
    if (id.empty()) then {
        return;
    }
    auto: rows = tool("equation\t" + id).split("\n");
    by("sv-notes").set_inner_text("");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 2l) then {
            continue;
        }
        if (f[0] == "formula") then {
            by("sv-formula").set_inner_text(f[1]);
        } else if (f[0] == "notes") then {
            by("sv-notes").set_inner_text(f[1]);
        } else if (f[0] == "var" && f.size() >= 6l) then {
            string: vid = f[1];
            if (sv_vars.empty()) then {
                sv_vars = vid;
            } else then {
                sv_vars = sv_vars + "," + vid;
            }
            add_option(unknown, vid, f[2]);
            grove::Element: row = cel("row", "var-row", "");
            row.append_child(cel("text", "var-label", f[2]));
            grove::Element: input = grove::create_element("input_string");
            input.set_attribute("id", "sv-v-" + vid);
            input.set_attribute("class", "grow");
            row.append_child(input);
            auto: units = f[5].split(",");
            if (units.size() > 1l) then {
                grove::Element: sel = grove::create_element("input_select");
                sel.set_attribute("id", "sv-u-" + vid);
                for (long int: k = 0l; k < units.size(); k += 1l) {
                    add_option(sel, units[k], "");
                }
                sel.set_value_string(f[4]);
                row.append_child(sel);
            } else then {
                row.append_child(cel("text", "muted", f[5]));
            }
            box.append_child(row);
        }
    }
    unknown.set_value_string("");
    by("sv-result").set_inner_text("");
} end function sv_load_equation

function sv_solve() -> void {
    string: id = by("sv-equation").value_string();
    auto: vars = sv_vars.split(",");
    string: spec = "";
    string: unknown = by("sv-unknown").value_string();
    long int: blanks = 0l;
    string: blank = "";
    for (long int: i = 0l; i < vars.size(); i += 1l) {
        if (vars[i].empty()) then {
            continue;
        }
        string: v = by("sv-v-" + vars[i]).value_string();
        string: unit = "";
        grove::Element: sel = by("sv-u-" + vars[i]);
        if (sel.exists()) then {
            unit = sel.value_string();
        }
        if (v.empty() || vars[i] == unknown) then {
            blanks += 1l;
            blank = vars[i];
            continue;
        }
        spec = spec + vars[i] + "=" + v + "|" + unit + ";";
    }
    if (unknown.empty()) then {
        if (blanks != 1l) then {
            by("sv-result").set_inner_text("Leave exactly one box blank, or pick what to solve for.");
            return;
        }
        unknown = blank;
    }
    string: out_unit = "";
    grove::Element: out_sel = by("sv-u-" + unknown);
    if (out_sel.exists()) then {
        out_unit = out_sel.value_string();
    }
    string: reply = tool("solve\t" + id + "\t" + spec + "\t" + unknown + "\t" + out_unit);
    if (field(reply, 0l) == "ok") then {
        by("sv-v-" + field(reply, 1l)).set_value_string(field(reply, 2l));
        string: msg = field(reply, 3l);
        if (!field(reply, 4l).empty()) then {
            msg = msg + "  (" + field(reply, 4l) + ")";
        }
        by("sv-result").set_inner_text(msg);
    } else then {
        by("sv-result").set_inner_text(field(reply, 1l));
    }
} end function sv_solve

function cv_fill_units() -> void {
    string: units = tool("unit_list\t" + by("cv-dim").value_string());
    fill_select("cv-from", units, by("cv-from").value_string());
    fill_select("cv-to", units, by("cv-to").value_string());
    auto: list = units.split("\n");
    if (list.size() > 1l && by("cv-from").value_string() == by("cv-to").value_string()) then {
        by("cv-to").set_value_string(list[1]);
    }
    cv_convert();
} end function cv_fill_units

function cv_convert() -> void {
    string: reply = tool("convert\t" + by("cv-value").value_float().to_string() + "\t" + by("cv-from").value_string() + "\t" + by("cv-to").value_string() + "\t" + by("cv-dim").value_string());
    if (field(reply, 0l) == "ok") then {
        by("cv-result").set_inner_text(field(reply, 2l));
    } else then {
        by("cv-result").set_inner_text(field(reply, 1l));
    }
} end function cv_convert

function phase_refresh(bool: props) -> void {
    fill_panel("ph-readouts", panel("phase", "readouts"));
    fill_panel("ph-selection", panel("phase", "selection"));
    if (props) then {
        phase_build_props();
    }
    phase_version = cmd("phase", "version");
} end function phase_refresh

function phase_send_point() -> void {
    cmd("phase", "point\t" + by("ph-t").value_float().to_string() + "\tK\t" + by("ph-p").value_float().to_string() + "\tPa");
    phase_refresh(false);
} end function phase_send_point

function phase_sync_point() -> void {
    string: pv = cmd("phase", "point_values\tK\tPa");
    by("ph-t").set_value_float(std::io::parse_float<short float>(field(pv, 0l)));
    by("ph-p").set_value_float(std::io::parse_float<short float>(field(pv, 1l)));
} end function phase_sync_point

function phase_send_axes() -> void {
    if (!by("ph-axes-custom").value_bool()) then {
        cmd("phase", "axes\t\t\t\t");
        return;
    }
    cmd("phase", "axes\t" + by("ph-tmin").value_float().to_string() + "\t" + by("ph-tmax").value_float().to_string() + "\t" + by("ph-pmin").value_float().to_string() + "\t" + by("ph-pmax").value_float().to_string());
} end function phase_send_axes

function phb_set_mode(const string&: mode) -> void {
    phb_mode = mode;
    cmd("phasebuild", "mode\t" + mode);
    seg_on("phb-mode-covalent,phb-mode-ionic,phb-mode-metallic", "phb-mode-" + mode);
    show_if("phb-covalent", mode == "covalent");
    show_if("phb-ionic", mode == "ionic");
    show_if("phb-metallic", mode == "metallic");
    if (mode == "ionic") then {
        status("phb-status", cmd("phasebuild", "ionic\t" + by("phb-cation").value_string() + "\t" + by("phb-anion").value_string()), "");
    } else if (mode == "metallic") then {
        status("phb-status", cmd("phasebuild", "metal\t" + by("phb-metal-spec").value_string()), "");
    }
    cmd("phasebuild", "frame");
} end function phb_set_mode

function phb_send_metals() -> void {
    auto: syms = by("phb-metals").value_string().split(" ");
    long int: n = 0l;
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        if (!syms[i].empty()) then {
            n += 1l;
        }
    }
    if (n == 0l) then {
        return;
    }
    string: share = round1(static_cast<short float>(100.0) / static_cast<short float>(n)).to_string();
    string: spec = "";
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        if (!syms[i].empty()) then {
            spec = spec + syms[i] + "=" + share + "; ";
        }
    }
    by("phb-metal-spec").set_value_string(spec);
    status("phb-status", cmd("phasebuild", "metal\t" + spec), "");
} end function phb_send_metals

function phase_saved_refresh() -> void {
    auto: rows = cmd("phase", "saved").split("\n");
    string: options_text = "";
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 2l) then {
            continue;
        }
        options_text = options_text + f[0] + "|" + f[1] + "\t" + f[1] + " (" + f[0] + ")\n";
    }
    fill_select("ph-saved", options_text, by("ph-saved").value_string());
} end function phase_saved_refresh

function phase_build_props() -> void {
    grove::Element: box = by("ph-props");
    cclear(box);
    auto: rows = cmd("phase", "props").split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 6l) then {
            continue;
        }
        string: key = f[0];
        string: unit = f[4];
        grove::Element: row = cel("row", "var-row", "");
        string: label = f[1];
        if (f[5] != "data") then {
            label = label + " (" + f[5] + ")";
        }
        row.append_child(cel("text", "var-label", label));
        grove::Element: input = grove::create_element("input_string");
        input.set_attribute("class", "grow");
        input.set_value_string(f[2]);
        input.on("change", [key, unit](grove::Event&: e) -> void {
            cmd("phase", "set_prop\t" + key + "\t" + e.target().value_string() + "\t" + unit);
            phase_refresh(true);
        });
        row.append_child(input);
        row.append_child(cel("text", "muted", unit));
        box.append_child(row);
    }
} end function phase_build_props

function orb_refresh() -> void {
    fill_select("orb-show", cmd("orbital", "subshells"), by("orb-show").value_string());
    fill_panel("orb-readouts", panel("orbital", "readouts"));
} end function orb_refresh

function cloud_refresh(bool: orbitals) -> void {
    if (orbitals) then {
        fill_select("cl-orbital", cmd("cloud", "orbitals"), cloud_keep);
        cloud_keep = "atom";
    }
    fill_panel("cl-readouts", panel("cloud", "readouts"));
} end function cloud_refresh

function element_refresh() -> void {
    cmd("element", "element\t" + by("el-table").value_string() + "\t" + by("el-charge").value_integer().to_string() + "\t" + by("el-neutrons").value_integer().to_string());
    cmd("element", "temperature\t" + by("el-t").value_float().to_string());
    fill_panel("el-readouts", panel("element", "readouts"));
} end function element_refresh

function molar(const string&: id) -> string {
    return (by(id).value_float() / static_cast<short float>(1000.0)).to_string();
} end function molar

function liters(const string&: id) -> string {
    return (by(id).value_float() * static_cast<short float>(1000.0)).to_string();
} end function liters

function kin_set_mode(const string&: mode) -> void {
    kin_mode = mode;
    seg_on("kin-mode-rate,kin-mode-mechanism,kin-mode-arrhenius,kin-mode-profile,kin-mode-boltzmann,kin-mode-fit", "kin-mode-" + mode);
    auto: modes = "rate,mechanism,arrhenius,profile,boltzmann,fit".split(",");
    for (long int: i = 0l; i < modes.size(); i += 1l) {
        show_if("kin-" + modes[i], modes[i] == mode);
    }
    kin_send();
} end function kin_set_mode

function kin_send() -> void {
    string: args = "";
    if (kin_mode == "rate") then {
        string: order = by("kin-order").value_string();
        if (order == "0") then {
            by("kin-k-unit").set_inner_text("M/s");
        } else if (order == "2") then {
            by("kin-k-unit").set_inner_text("1/(M·s)");
        } else then {
            by("kin-k-unit").set_inner_text("1/s");
        }
        args = "rate\t" + order + "\t" + by("kin-k").value_float().to_string() + "\t" + by("kin-a0").value_float().to_string() + "\t" + by("kin-tmax").value_float().to_string() + "\t" + by("kin-plot").value_string();
    } else if (kin_mode == "mechanism") then {
        args = "mechanism\t" + by("kin-steps").value_string() + "\t" + by("kin-init").value_string() + "\t" + by("kin-mech-tmax").value_float().to_string();
    } else if (kin_mode == "arrhenius") then {
        args = "arrhenius\t" + by("kin-ea").value_float().to_string() + "\t" + by("kin-prefactor").value_float().to_string() + "\t" + by("kin-t1").value_float().to_string() + "\t" + by("kin-t2").value_float().to_string() + "\t" + by("kin-arr-plot").value_string();
    } else if (kin_mode == "profile") then {
        string: cat = "";
        if (by("kin-cat").value_bool()) then {
            cat = by("kin-ea-cat").value_float().to_string();
        }
        args = "profile\t" + by("kin-dh").value_float().to_string() + "\t" + by("kin-prof-ea").value_float().to_string() + "\t" + cat;
    } else if (kin_mode == "boltzmann") then {
        args = "boltzmann\t" + by("kin-gas").value_string() + "\t" + by("kin-mb-t1").value_float().to_string() + "\t" + by("kin-mb-t2").value_float().to_string() + "\t" + by("kin-mb-ea").value_float().to_string();
    } else then {
        args = "fit\t" + by("kin-data").value_string();
    }
    status("kin-status", cmd("kinetics", args), "");
    fill_panel("kin-readouts", panel("kinetics", "readouts"));
} end function kin_send

function ab_set_mode(const string&: mode) -> void {
    ab_mode = mode;
    seg_on("ab-mode-mixture,ab-mode-titration,ab-mode-species,ab-mode-buffer", "ab-mode-" + mode);
    auto: modes = "mixture,titration,species,buffer".split(",");
    for (long int: i = 0l; i < modes.size(); i += 1l) {
        show_if("ab-" + modes[i], modes[i] == mode);
    }
    ab_send();
} end function ab_set_mode

function strength_of(const string&: combo, long int: index) -> string {
    if (combo == "any" || combo.empty()) then {
        return "both";
    }
    auto: parts = combo.split("-");
    if (index < parts.size()) then {
        return parts[index];
    }
    return "both";
} end function strength_of

function ab_titration_setup(bool: defaults) -> void {
    bool: acid_in_flask = by("ab-flask-kind").value_string() == "acid";
    string: combo = by("ab-combo").value_string();
    string: flask = strength_of(combo, 0l);
    string: added = strength_of(combo, 1l);
    show_if("ab-flask-acid", acid_in_flask);
    show_if("ab-flask-base", !acid_in_flask);
    show_if("ab-tit-base", acid_in_flask);
    show_if("ab-tit-acid", !acid_in_flask);
    by("ab-flask-acid").set_attribute("strength", flask);
    by("ab-flask-base").set_attribute("strength", flask);
    by("ab-tit-base").set_attribute("strength", added);
    by("ab-tit-acid").set_attribute("strength", added);
    if (defaults) then {
        if (flask == "strong") then {
            by("ab-flask-acid").set_value_string("hydrochloric acid");
            by("ab-flask-base").set_value_string("sodium hydroxide");
        } else if (flask == "weak") then {
            by("ab-flask-acid").set_value_string("acetic acid");
            by("ab-flask-base").set_value_string("ammonia");
        }
        if (added == "strong") then {
            by("ab-tit-base").set_value_string("sodium hydroxide");
            by("ab-tit-acid").set_value_string("hydrochloric acid");
        } else if (added == "weak") then {
            by("ab-tit-base").set_value_string("ammonia");
            by("ab-tit-acid").set_value_string("acetic acid");
        }
    }
} end function ab_titration_setup

function mx_setup(long int: i) -> void {
    string: n = i.to_string();
    bool: acid = by("mx-role-" + n).value_string() == "acid";
    string: how = by("mx-how-" + n).value_string();
    show_if("mx-acid-" + n, acid);
    show_if("mx-base-" + n, !acid);
    show_if("mx-crow-" + n, how == "sol");
    show_if("mx-vrow-" + n, how == "sol");
    show_if("mx-nrow-" + n, how == "mol");
    show_if("mx-grow-" + n, how == "g");
} end function mx_setup

function mx_spec() -> string {
    string: spec = "";
    for (long int: i = 0l; i < mx_count; i += 1l) {
        string: n = i.to_string();
        if (by("mx-row-" + n).has_class("hidden")) then {
            continue;
        }
        string: role = by("mx-role-" + n).value_string();
        string: name = by("mx-acid-" + n).value_string();
        if (role == "base") then {
            name = by("mx-base-" + n).value_string();
        }
        string: how = by("mx-how-" + n).value_string();
        string: item = role + "|" + name + "|" + how + "|";
        if (how == "sol") then {
            item = item + molar("mx-c-" + n) + "|" + liters("mx-v-" + n);
        } else if (how == "mol") then {
            item = item + by("mx-n-" + n).value_float().to_string();
        } else then {
            item = item + (by("mx-m-" + n).value_float() * static_cast<short float>(1000.0)).to_string();
        }
        spec = spec + item + ";";
    }
    return spec;
} end function mx_spec

function ab_send() -> void {
    string: args = "";
    if (ab_mode == "mixture") then {
        if (mx_typed) then {
            args = "mixture\t" + by("ab-mix").value_string() + "\t" + by("ab-t").value_float().to_string();
        } else then {
            args = "mix\t" + mx_spec() + "\t" + liters("mx-water") + "\t" + by("ab-t").value_float().to_string();
        }
    } else if (ab_mode == "titration") then {
        string: kind = by("ab-flask-kind").value_string();
        string: analyte = by("ab-flask-acid").value_string();
        string: titrant = by("ab-tit-base").value_string();
        if (kind == "base") then {
            analyte = by("ab-flask-base").value_string();
            titrant = by("ab-tit-acid").value_string();
        }
        args = "titration\t" + analyte + "\t" + molar("ab-ca") + "\t" + liters("ab-va") + "\t" + molar("ab-ct") + "\t" + liters("ab-vmax") + "\t" + titrant + "\t" + kind + "\t" + liters("ab-vadd") + "\t" + by("ab-vunit").value_string();
    } else if (ab_mode == "species") then {
        args = "species\t" + by("ab-species-acid").value_string();
    } else then {
        args = "buffer\t" + by("ab-buffer-acid").value_string() + "\t" + molar("ab-buf-ca") + "\t" + molar("ab-buf-cb") + "\t" + molar("ab-buf-add");
    }
    string: reply = cmd("acidbase", args);
    if (field(reply, 0l) == "ok") then {
        string: shown = "pH " + field(reply, 1l);
        if (!field(reply, 2l).empty()) then {
            shown = shown + "  ·  pOH " + field(reply, 2l);
        }
        by("ab-status").set_inner_text(shown);
    } else then {
        status("ab-status", reply, "");
    }
    fill_panel("ab-readouts", panel("acidbase", "readouts"));
} end function ab_send

function spe_refresh(const string&: reply) -> void {
    if (field(reply, 0l) == "error") then {
        by("spe-status").set_inner_text(field(reply, 1l));
    } else then {
        by("spe-status").set_inner_text(field(reply, 1l));
    }
    fill_panel("spe-readouts", panel("spectra", "readouts"));
} end function spe_refresh

function spe_send_common() -> void {
    cmd("spectra", "range\t" + by("spe-start").value_float().to_string() + "\t" + by("spe-end").value_float().to_string());
    cmd("spectra", "fwhm\t" + by("spe-fwhm").value_float().to_string());
    cmd("spectra", "candidates\t" + by("spe-candidates").value_string());
    cmd("spectra", "kind\t" + by("spe-kind").value_string());
} end function spe_send_common

function spe_build_sliders() -> void {
    grove::Element: box = by("spe-fractions");
    cclear(box);
    auto: syms = by("spe-elements").value_string().split(" ");
    long int: n = 0l;
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        if (!syms[i].empty()) then {
            n += 1l;
        }
    }
    if (n == 0l) then {
        return;
    }
    short float: share = round1(static_cast<short float>(100.0) / static_cast<short float>(n));
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        string: sym = syms[i];
        if (sym.empty()) then {
            continue;
        }
        grove::Element: row = cel("row", "line", "");
        row.append_child(cel("text", "label-w", sym));
        grove::Element: sl = grove::create_element("input_slider");
        sl.set_attribute("id", "spf-" + sym);
        sl.set_attribute("class", "grow");
        sl.set_attribute("min", "0");
        sl.set_attribute("max", "100");
        sl.set_attribute("step", "0.1");
        sl.set_value_float(share);
        sl.on("input", [sym](grove::Event&: e) -> void {
            spe_normalize(sym);
            spe_send_mix();
        });
        sl.on("change", [sym](grove::Event&: e) -> void {
            spe_normalize(sym);
            spe_send_mix();
        });
        row.append_child(sl);
        box.append_child(row);
    }
} end function spe_build_sliders

function spe_normalize(const string&: changed) -> void {
    auto: syms = by("spe-elements").value_string().split(" ");
    short float: hundred = static_cast<short float>(100.0);
    short float: zero = static_cast<short float>(0.0);
    short float: fixed_value = by("spf-" + changed).value_float();
    short float: others = zero;
    long int: count = 0l;
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        if (syms[i].empty() || syms[i] == changed || !by("spf-" + syms[i]).exists()) then {
            continue;
        }
        others = others + by("spf-" + syms[i]).value_float();
        count += 1l;
    }
    if (count == 0l) then {
        fixed_value = hundred;
    }
    short float: left = hundred - fixed_value;
    short float: used = zero;
    long int: seen = 0l;
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        if (syms[i].empty() || syms[i] == changed || !by("spf-" + syms[i]).exists()) then {
            continue;
        }
        seen += 1l;
        short float: v = zero;
        if (seen == count) then {
            v = left - used;
        } else if (others > zero) then {
            v = round1(by("spf-" + syms[i]).value_float() * left / others);
        } else then {
            v = round1(left / static_cast<short float>(count));
        }
        if (v < zero) then {
            v = zero;
        }
        used = used + v;
        by("spf-" + syms[i]).set_value_float(v);
    }
    by("spf-" + changed).set_value_float(fixed_value);
} end function spe_normalize

function spe_send_mix() -> void {
    auto: syms = by("spe-elements").value_string().split(" ");
    string: spec = "";
    for (long int: i = 0l; i < syms.size(); i += 1l) {
        if (syms[i].empty() || !by("spf-" + syms[i]).exists()) then {
            continue;
        }
        spec = spec + syms[i] + " " + by("spf-" + syms[i]).value_float().to_string() + ";";
    }
    spe_send_common();
    spe_refresh(cmd("spectra", "mix\t" + spec));
} end function spe_send_mix

function spe_set_mode(const string&: mode) -> void {
    spe_mode = mode;
    seg_on("spe-mode-mix,spe-mode-identify,spe-mode-color", "spe-mode-" + mode);
    show_if("spe-mix", mode == "mix");
    show_if("spe-identify", mode == "identify");
    show_if("spe-color", mode == "color");
    show_if("spe-candidates-box", mode != "mix");
    if (mode == "mix") then {
        spe_send_mix();
    } else if (mode == "identify") then {
        spe_send_common();
        spe_refresh(cmd("spectra", "observed\t" + by("spe-observed").value_string()));
    } else then {
        spe_send_common();
        spe_refresh(cmd("spectra", "color\t" + by("spe-target").value_color() + "\t" + by("spe-color-basis").value_string()));
    }
} end function spe_set_mode

function units_build() -> void {
    grove::Element: box = by("units-prefs");
    cclear(box);
    auto: dims = unit_dims.split(",");
    for (long int: i = 0l; i < dims.size(); i += 1l) {
        string: dim = dims[i];
        grove::Element: row = cel("row", "var-row", "");
        row.append_child(cel("text", "var-label", dim));
        grove::Element: sel = grove::create_element("input_select");
        auto: units = tool("unit_list\t" + dim).split("\n");
        for (long int: k = 0l; k < units.size(); k += 1l) {
            if (!units[k].empty()) then {
                add_option(sel, units[k], "");
            }
        }
        sel.set_value_string(tool("units\t" + dim + "\t"));
        sel.on("change", [dim](grove::Event&: e) -> void {
            tool("units\t" + dim + "\t" + e.target().value_string());
            refresh_all();
        });
        row.append_child(sel);
        box.append_child(row);
    }
    by("units-save-dir").set_inner_text("The bonding sandbox saves into " + tool("save_dir") + " (one folder each for covalent, ionic and metallic). Set SAPLING_SAVE_DIR to keep them somewhere else.");
} end function units_build

function refresh_all() -> void {
    bond_refresh();
    phase_refresh(true);
    orb_refresh();
    cloud_refresh(false);
    element_refresh();
    fill_panel("ions-structure", panel("structure", "readouts"));
    fill_panel("kin-readouts", panel("kinetics", "readouts"));
    fill_panel("ab-readouts", panel("acidbase", "readouts"));
    fill_panel("spe-readouts", panel("spectra", "readouts"));
} end function refresh_all

