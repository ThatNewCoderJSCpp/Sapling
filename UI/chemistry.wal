auto: kin_modes = "rate,mechanism,arrhenius,profile,boltzmann,fit".split(",");
for (long int: i = 0l; i < kin_modes.size(); i += 1l) {
    string: m = kin_modes[i];
    on_click("kin-mode-" + m, [m]() -> void { kin_set_mode(m); });
}
auto: kin_inputs = "kin-order,kin-k,kin-a0,kin-tmax,kin-plot,kin-ea,kin-prefactor,kin-t1,kin-t2,kin-arr-plot,kin-dh,kin-prof-ea,kin-cat,kin-ea-cat,kin-gas,kin-mb-t1,kin-mb-t2,kin-mb-ea,kin-steps,kin-init,kin-mech-tmax,kin-data".split(",");
for (long int: i = 0l; i < kin_inputs.size(); i += 1l) {
    on_change(kin_inputs[i], []() -> void { kin_send(); });
}
on_click("kin-mech-go", []() -> void { kin_send(); });
on_click("kin-fit-go", []() -> void { kin_send(); });

string: acid_list = cmd("acidbase", "acids");
fill_select("ab-species-acid", acid_list, "phosphoric acid");
fill_select("ab-buffer-acid", acid_list, "acetic acid");
auto: ab_modes = "mixture,titration,species,buffer".split(",");
for (long int: i = 0l; i < ab_modes.size(); i += 1l) {
    string: m = ab_modes[i];
    on_click("ab-mode-" + m, [m]() -> void { ab_set_mode(m); });
}
auto: ab_inputs = "ab-vadd,ab-vunit,ab-t,ab-flask-acid,ab-flask-base,ab-tit-base,ab-tit-acid,ab-ca,ab-va,ab-ct,ab-vmax,ab-species-acid,ab-buffer-acid,ab-buf-ca,ab-buf-cb,ab-buf-add,ab-mix".split(",");
for (long int: i = 0l; i < ab_inputs.size(); i += 1l) {
    on_change(ab_inputs[i], []() -> void { ab_send(); });
}
on_click("ab-mix-go", []() -> void { ab_send(); });
by("ab-vadd").on("input", [](grove::Event&: e) -> void { ab_send(); });
for (long int: i = 0l; i < mx_count; i += 1l) {
    string: n = i.to_string();
    long int: row = i;
    mx_setup(row);
    on_change("mx-role-" + n, [row]() -> void {
        mx_setup(row);
        ab_send();
    });
    on_change("mx-how-" + n, [row]() -> void {
        mx_setup(row);
        ab_send();
    });
    auto: fields = "mx-acid-,mx-base-,mx-c-,mx-v-,mx-n-,mx-m-".split(",");
    for (long int: k = 0l; k < fields.size(); k += 1l) {
        on_change(fields[k] + n, []() -> void { ab_send(); });
    }
    on_click("mx-del-" + n, [n]() -> void {
        by("mx-row-" + n).add_class("hidden");
        ab_send();
    });
}
on_change("mx-water", []() -> void { ab_send(); });
on_click("mx-add", []() -> void {
    for (long int: i = 0l; i < mx_count; i += 1l) {
        grove::Element: r = by("mx-row-" + i.to_string());
        if (r.has_class("hidden")) then {
            r.remove_class("hidden");
            ab_send();
            return;
        }
    }
});
on_click("mx-build", []() -> void {
    mx_typed = false;
    seg_on("mx-build,mx-type", "mx-build");
    show_if("mx-builder", true);
    show_if("mx-typed", false);
    ab_send();
});
on_click("mx-type", []() -> void {
    mx_typed = true;
    seg_on("mx-build,mx-type", "mx-type");
    show_if("mx-builder", false);
    show_if("mx-typed", true);
    ab_send();
});
