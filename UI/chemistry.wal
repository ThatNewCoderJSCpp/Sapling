    spe_send_common();
    spe_refresh(cmd("spectra", "observed\t" + by("spe-observed").value_string()));
});
on_change("spe-observed", []() -> void {
    spe_send_common();
    spe_refresh(cmd("spectra", "observed\t" + by("spe-observed").value_string()));
});
on_click("spe-image-go", []() -> void {
    string: path = by("spe-image").value_string();
    string: top = (by("spe-top").value_float() / static_cast<short float>(100.0)).to_string();
    string: bottom = (by("spe-bottom").value_float() / static_cast<short float>(100.0)).to_string();
    string: reply = ccall("chem.image", path + "\tprofile\t" + top + "\t" + bottom);
    if (field(reply, 0l) != "ok") then {
        by("spe-status").set_inner_text(field(reply, 1l));
        return;
    }
    spe_send_common();
    spe_refresh(cmd("spectra", "profile\t" + by("spe-left").value_float().to_string() + "\t" + by("spe-right").value_float().to_string() + "\t" + field(reply, 1l)));
});
on_change("spe-image", []() -> void { by("spe-status").set_inner_text("Set the edges' wavelengths, then Read the image."); });
on_click("spe-color-go", []() -> void { spe_set_mode("color"); });
on_change("spe-target", []() -> void { spe_set_mode("color"); });
on_change("spe-color-basis", []() -> void { spe_set_mode("color"); });
on_change("spe-color-image", []() -> void {
    string: reply = ccall("chem.image", by("spe-color-image").value_string() + "\tcolor\t0\t1");
    if (field(reply, 0l) != "ok") then {
        by("spe-status").set_inner_text(field(reply, 1l));
        return;
    }
    by("spe-target").set_value_color(field(reply, 1l));
    spe_set_mode("color");
});
