on_change("ab-poh", []() -> void {
    if (by("ab-poh").value_bool()) then {
        cmd("acidbase", "scale\tpoh");
    } else then {
        cmd("acidbase", "scale\tph");
    }
    ab_send();
});

grove::set_interval(200.0, []() -> void {
    if (!by("chemistry").is_current()) then {
        return;
    }
    if (by("chem-bonding").is_current() && bond_mode == "network") then {
        string: nv = cmd("network", "version");
        if (nv != net_version) then {
            net_version = nv;
            bond_refresh();
        }
    } else if (by("chem-bonding").is_current()) then {
        string: v = cmd("bond", "version");
        if (v != bond_version) then {
            bond_version = v;
            bond_refresh();
        }
    }
    if (by("chem-phase").is_current()) then {
        string: v = cmd("phase", "version");
        if (v != phase_version) then {
            phase_version = v;
            phase_sync_point();
            fill_panel("ph-readouts", panel("phase", "readouts"));
            fill_panel("ph-selection", panel("phase", "selection"));
        }
    }
});

