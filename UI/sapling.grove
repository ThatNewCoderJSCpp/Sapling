<!grove>
<grove>
    <head>
        <title>Sapling</title>
        <style src="sapling.bark"></style>
        <style src="chemistry.bark"></style>
        <script lang="walnut" src="sapling.wal"></script>
        <script lang="walnut" src="chemistry.wal"></script>
    </head>
    <body id="app" title="Sapling" app-id="sapling">
        <row class="appbar">
            <text class="brand">Sapling</text>
            <button class="section" to="sandbox">Physics</button>
            <button class="section" to="chemistry">Chemistry</button>
            <div class="grow"></div>
            <text id="version" class="muted"></text>
        </row>
        <page id="sandbox" current>
            <row class="topbar">
                <text class="tagline">physics sandbox</text>
                <div class="grow"></div>
                <button id="play" class="primary">Pause</button>
                <button id="step" class="ghost" title="Advance one frame">Step</button>
                <button id="reset" class="ghost">Reset</button>
                <text class="muted">speed</text>
                <input_select id="speed" class="speed" value="1">
                    <option value="0.1">0.1&#215;</option>
                    <option value="0.25">0.25&#215;</option>
                    <option value="0.5">0.5&#215;</option>
                    <option value="1">1&#215;</option>
                    <option value="2">2&#215;</option>
                    <option value="4">4&#215;</option>
                    <option value="10">10&#215;</option>
                </input_select>
            </row>
            <row id="workspace">
                <column id="side" class="scroll">
                    <h3 class="side-title">Settings</h3>
                    <column id="params" class="params"></column>
                    <h3 class="side-title">Readouts</h3>
                    <column id="readouts" class="readouts"></column>
                </column>
                <column id="stage">
                    <canvas id="view" />
                </column>
            </row>
        </page>
        <page id="chemistry">
            <row class="subtabs">
                <button class="subtab" to="chem-bonding">Bonding sandbox</button>
                <button class="subtab" to="chem-ions">Ions &amp; names</button>
                <button class="subtab" to="chem-reactions">Reactions</button>
                <button class="subtab" to="chem-solvers">Solvers</button>
                <button class="subtab" to="chem-kinetics">Kinetics</button>
                <button class="subtab" to="chem-acids">Acids &amp; bases</button>
                <button class="subtab" to="chem-phase">Phase diagrams</button>
                <button class="subtab" to="chem-orbitals">Radial probability</button>
                <button class="subtab" to="chem-cloud">Electron clouds</button>
                <button class="subtab" to="chem-elements">Elements</button>
                <button class="subtab" to="chem-units">Units</button>
            </row>
            <page id="chem-bonding" src="chemistry/bonding.grove" current />
            <page id="chem-ions" src="chemistry/ions.grove" />
            <page id="chem-reactions" src="chemistry/reactions.grove" />
            <page id="chem-solvers" src="chemistry/solvers.grove" />
            <page id="chem-kinetics" src="chemistry/kinetics.grove" />
            <page id="chem-acids" src="chemistry/acids.grove" />
            <page id="chem-phase" src="chemistry/phase.grove" />
            <page id="chem-orbitals" src="chemistry/orbitals.grove" />
            <page id="chem-cloud" src="chemistry/cloud.grove" />
            <page id="chem-elements" src="chemistry/elements.grove" />
            <page id="chem-units" src="chemistry/units.grove" />
        </page>
    </body>
</grove>
